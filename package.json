{
  "name": "dishpatch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dishpatch/api --filter @dishpatch/web dev",
    "build": "pnpm -r build",
    "lint": "biome check --error-on-warnings .",
    "lint:sql": "node scripts/lint-sql.mjs",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --project shared --project api-unit --project web",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run --project api-int",
    "test:e2e": "pnpm --filter @dishpatch/e2e exec playwright test",
    "db:generate": "pnpm --filter @dishpatch/api db:generate",
    "db:migrate": "pnpm --filter @dishpatch/api db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
